# Copy this file to .env.local for local development.
# npm start / npm run dev load .env.local automatically (node --env-file-if-exists).
# Production/container deployments must supply these through the real process
# environment instead of an env file.

# --- Radio transport ---------------------------------------------------
# "serial" (default, current Windows deployment) or "tcp" (future container transport)
PACKETCAPTURE_CONNECTION_TYPE=serial

# Comma-separated list of candidate serial ports. The manager tries them in order.
PACKETCAPTURE_SERIAL_PORTS=COM3

# Used only when PACKETCAPTURE_CONNECTION_TYPE=tcp
PACKETCAPTURE_TCP_HOST=
PACKETCAPTURE_TCP_PORT=

# 0 = retry forever. Values >0 cap the number of reconnect attempts.
PACKETCAPTURE_MAX_CONNECTION_RETRIES=0
# Initial backoff delay in milliseconds.
PACKETCAPTURE_CONNECTION_RETRY_DELAY=3000
# Backoff ceiling in milliseconds.
PACKETCAPTURE_CONNECTION_RETRY_DELAY_MAX=15000

# --- Observer identity ---------------------------------------------------
PACKETCAPTURE_IATA=CVG
PACKETCAPTURE_OWNER_EMAIL=

# --- Logging ---------------------------------------------------
# debug | info | warn | error
PACKETCAPTURE_LOG_LEVEL=info

# --- MQTT brokers ---------------------------------
# Path to a JSON file defining zero or more independent MQTT brokers (host,
# port, transport, auth method, etc). See brokers.config.example.json for
# the shape. Optional: if unset, the default path "brokers.config.json" is
# used, and if that file doesn't exist either, no brokers are configured at
# all (not an error). Setting this var explicitly to a path that doesn't
# exist IS a startup error.
PACKETCAPTURE_BROKERS_CONFIG_FILE=

# Passwords for the two password-auth placeholder brokers in
# brokers.config.example.json. Their auth.passwordEnv values map each broker
# to its own variable. Replace the example hosts/usernames and set real
# secret values before using the example broker configuration.
MQTT1_EXAMPLE_PASSWORD=
MQTT2_EXAMPLE_PASSWORD=

# MeshMapper/LetsMesh token-auth and anonymous OKIMesh examples do not use
# static password variables.

# Legacy fallback for password-auth brokers without auth.passwordEnv:
# PACKETCAPTURE_MQTT<n>_PASSWORD uses the broker's 1-based array position.
# It remains supported during v2.x, but reordering the broker array can
# associate the value with a different broker. Brokers using "none" or
# "token" auth do not need a password (token JWTs are signed on-device).
PACKETCAPTURE_MQTT1_PASSWORD=

# --- Channel bots ---------------------------------
# Path to a JSON file defining zero or more independent channel bots (each
# with its own channel, minimum hops, and trigger -> response-template
# commands). See bots.config.example.json for the shape, including the
# baseline #echo behavior. Optional: if unset, the default path
# "bots.config.json" is used, and if that file doesn't exist either, no
# bots are configured at all (not an error). Setting this var explicitly
# to a path that doesn't exist IS a startup error.
PACKETCAPTURE_BOTS_CONFIG_FILE=

# Every bot reply goes through one shared, FIFO, quiet-window-gated queue
# (not sent immediately) - see README's "Channel bots" section for the full
# rationale. GRP_TXT channel messages carry no protocol ACK to retry
# against, so this isn't about guaranteeing delivery: it holds a reply
# until the shared RF channel has been quiet for PACKETCAPTURE_BOT_REPLY_QUIET_MS,
# letting the *triggering* message's own flood propagation settle before
# adding new channel traffic. A reply waiting longer than
# PACKETCAPTURE_BOT_REPLY_TTL_MS is dropped unsent rather than sent stale.
# Defaults reflect field testing on a real mesh.
PACKETCAPTURE_BOT_REPLY_QUIET_MS=5000
PACKETCAPTURE_BOT_REPLY_TTL_MS=60000

# After a reply is sent, how long a bot waits to hear that exact reply
# echoed back on the same channel - necessarily a rebroadcast by another
# node, since a device can't hear its own outgoing transmission - before
# giving up and counting it unconfirmed. Diagnostic only (see the
# dashboard's per-bot "repeats confirmed/unconfirmed" counters); does not
# affect whether or when a reply is sent. Defaults to 10 seconds after send;
# set to 0 for an immediate timeout (counted on the next tracker sweep).
PACKETCAPTURE_BOT_REPLY_REPEAT_CHECK_MS=10000

# Send the Companion's own flood advert once after radio startup, then at
# this interval. Flood adverts may be retransmitted by repeaters, so local
# community guidance recommends 47 hours between periodic flood adverts.
# Set to 0 for startup-only. One-hour zero-hop adverts are a separate mode.
PACKETCAPTURE_FLOOD_ADVERT_INTERVAL_HOURS=47

# --- Remote request coordination ----------------
# Internal foundation only: startup schedules no discovery or telemetry polls.
# Whole-number values; timeouts/spacing use milliseconds. Omitted settings
# use these defaults; blank/invalid values fail startup. Queue admission and
# physical write/ACK have separate deadlines.
# ACK: 1000–30000 ms. Missing ACK resets the captured transport generation.
PACKETCAPTURE_REMOTE_REQUEST_ACK_TIMEOUT_MS=5000
# Response cap: 1000–120000 ms, including the Companion estimate + 1000 ms margin.
PACKETCAPTURE_REMOTE_REQUEST_RESPONSE_TIMEOUT_MAX_MS=30000
# Spacing: 10000–3600000 ms between physical attempts; first send waits one interval.
PACKETCAPTURE_REMOTE_REQUEST_MIN_INTERVAL_MS=60000
# Sliding minute attempt cap: 1–6. Failures count; reconnect preserves the budget.
# Pending replies/adverts and shared quiet air also gate every dispatch.
PACKETCAPTURE_REMOTE_REQUEST_MAX_PER_MINUTE=1

# Verified zero-hop repeater reception evidence remains eligible for this
# many whole hours (1–8760). Default/fallback is 72; no unlimited sentinel.
# Relayed receptions do not refresh this window. This records eligibility;
# region polling is a separate opt-in feature, not enabled by this setting.
PACKETCAPTURE_DIRECT_HEARD_WINDOW_HOURS=72

# Region-answer age uses the original Observer receipt time. Whole hours 1–8760;
# omitted defaults to 72. Separate from direct-advert evidence and poll cadence.
# This labels stored answers; it does not enable region requests or publication.
PACKETCAPTURE_REGION_ANSWER_FRESHNESS_HOURS=72

# Saved telemetry observation freshness, separate from polling and pruning.
# Whole hours 1..8760; omitted defaults to 72. Explicit empty/invalid fails startup.
# History uses PACKETCAPTURE_METRICS_UI_RETENTION_DAYS (0 = unlimited), even UI-off.
# This setting does not enable telemetry collection or replace missing measurements.
PACKETCAPTURE_TELEMETRY_FRESHNESS_HOURS=72

# --- Telemetry polling (startup contracts; producer arrives in #34 T5) ---
# Disabled by default. T1 only validates these settings; it sends no requests.
# Explicit blanks/invalid values fail startup, even while disabled.
PACKETCAPTURE_TELEMETRY_POLL_ENABLED=false
# Distance one is a direct target; existing direct contact routes must fit 1–63.
PACKETCAPTURE_TELEMETRY_POLL_RADIUS=2
# Passive reporter-scoped eligibility; whole hours 1–8760, separate from sample age.
PACKETCAPTURE_TELEMETRY_POLL_EVIDENCE_HOURS=72
# Per-component refresh objective; whole hours 1–8760, subject to the shared RF budget.
PACKETCAPTURE_TELEMETRY_POLL_INTERVAL_HOURS=24
# Whole seconds 1–3600 / 1–60 / 1–30; tick is selection, not an RF send interval.
PACKETCAPTURE_TELEMETRY_POLL_STARTUP_DELAY_SECONDS=75
PACKETCAPTURE_TELEMETRY_POLL_TICK_SECONDS=10
PACKETCAPTURE_TELEMETRY_POLL_PREFLIGHT_SECONDS=5
# Guest proof stays in memory, generation scoped; whole minutes 1–60.
PACKETCAPTURE_TELEMETRY_POLL_SESSION_MINUTES=10
# Whole minutes 1–10080; retry maximum must be at least retry base.
PACKETCAPTURE_TELEMETRY_POLL_RETRY_BASE_MINUTES=15
PACKETCAPTURE_TELEMETRY_POLL_RETRY_MAX_MINUTES=360
# Whole attempts 1–10, including the initial physical attempt.
PACKETCAPTURE_TELEMETRY_POLL_MAX_ATTEMPTS=3
# Authentication denial/unsafe-response cooldown; whole hours 1–8760.
PACKETCAPTURE_TELEMETRY_POLL_AUTH_COOLDOWN_HOURS=24
# Supply BOTH paths deliberately to configure credentials; omitted defaults are inert.
# Explicit files are validated as a pair even while disabled. Never put passwords here.
# See docs/telemetry-polling.md and the two synthetic JSON examples.
# PACKETCAPTURE_TELEMETRY_POLL_CONFIG_FILE=telemetry.config.json
# PACKETCAPTURE_TELEMETRY_POLL_SECRETS_FILE=telemetry.secrets.json

# --- Region discovery (contracts; query producer is not wired yet) ---
# These defaults do not activate radio traffic until the producer is delivered.
# Strict true/false; omit to use false. Explicit blank/invalid values fail startup.
PACKETCAPTURE_REGION_DISCOVERY_ENABLED=false
# Normal refresh: whole hours 1–8760, independent of the 72-hour evidence/age labels.
PACKETCAPTURE_REGION_QUERY_REFRESH_HOURS=24
# Failed-attempt exponential backoff: whole minutes 3–1440; positive jitter only.
PACKETCAPTURE_REGION_QUERY_RETRY_BASE_MINUTES=15
# Whole hours 1–168; must be at least the retry base. Default maximum is six hours.
PACKETCAPTURE_REGION_QUERY_RETRY_MAX_HOURS=6
# Target-cycle reservations including the initial attempt: whole 1–10.
# A reservation does not prove RF transmission; exhausted cycles wait for refresh.
PACKETCAPTURE_REGION_QUERY_MAX_ATTEMPTS=3
# Nonoverlapping selection tick 1000–60000ms; this is not an RF send interval.
PACKETCAPTURE_REGION_QUERY_TICK_INTERVAL_MS=10000
# Initial producer delay 10000–3600000ms; reconnect never resets retry budgets.
PACKETCAPTURE_REGION_QUERY_STARTUP_DELAY_MS=60000
# Local exact-key contact read deadline 1000–30000ms; no contact mutation/flood fallback.
PACKETCAPTURE_REGION_QUERY_PREFLIGHT_TIMEOUT_MS=5000
# Shared remote budget, foreground work and quiet air remain authoritative.
# Omitted numeric values use these defaults; explicit blanks/fractions fail startup.

# Optional cleanup of redundant advert fingerprints for repeaters unheard
# for at least this many days (whole days 0–36500). 0/default keeps them forever.
# Example: 7. Inventory/direct evidence, retained event fingerprints and the
# original discovery fingerprint survive. Shared history retention is separate.
# Old pruned non-discovery adverts may count again as re-hears after cleanup.
PACKETCAPTURE_REPEATER_FINGERPRINT_PRUNE_AFTER_DAYS=0

# --- Passive topology ---------------------------
# Observed flood-relay proximity only; no outbound route or reachability proof.
# Whole hours 1–8760; omitted defaults to 72. Separate from direct-advert freshness.
PACKETCAPTURE_TOPOLOGY_FRESHNESS_HOURS=72
# Rolling monotonic minute of write attempts, including failures. Whole 1–6000.
# Omitted defaults to 600. Physical repeated receptions count separately.
# Suppressed traffic does not refresh proximity; coverage is sampled below.
PACKETCAPTURE_TOPOLOGY_MAX_OBSERVATIONS_PER_MINUTE=600
# 0 = keep path summaries indefinitely (default). Whole days 0–36500.
# Opt-in inactive-path cleanup waits until no retained reception details refer
# to that path. Detail/coverage use METRICS_UI_RETENTION_DAYS below.
PACKETCAPTURE_TOPOLOGY_PRUNE_AFTER_DAYS=0

# --- Metrics UI ---------------------------------
# The local SQLite data store (node:sqlite) below is always on - it's this
# observer's core persisted state (packet/bot-reply metrics, the !lookup
# repeater registry), not something specific to the dashboard. ENABLED only
# gates the optional live HTTP dashboard (radio/MQTT/bot status, packet
# counters) on top of it. Off by default. There is NO authentication, so
# the host defaults to loopback-only (127.0.0.1) - only set it to 0.0.0.0
# or a LAN address if you understand the endpoint will be reachable
# unauthenticated.
PACKETCAPTURE_METRICS_UI_ENABLED=false
PACKETCAPTURE_METRICS_UI_HOST=127.0.0.1
PACKETCAPTURE_METRICS_UI_PORT=8090
# How often (ms) health state is sampled and a packet-activity sample is
# persisted for the range-selectable history chart/table/pie chart. Applies
# regardless of whether the dashboard itself is enabled.
PACKETCAPTURE_METRICS_UI_SAMPLE_INTERVAL_MS=10000
# Where all persisted state is stored (local SQLite file via node:sqlite) -
# packet/bot-command metrics and the !lookup repeater registry alike.
# Survives restarts; back this up like any other data file if you care
# about long-term history. Node >=22.13.0 (node:sqlite support) is a hard
# requirement to start at all, not just for the dashboard.
PACKETCAPTURE_METRICS_UI_DB_PATH=data/metrics.sqlite3
# Days of persisted metrics history to keep. 0 = unlimited (operator is
# responsible for watching disk usage).
# Region answer/outcome/publication history shares this policy. Latest answers
# and pending/publishing work remain saved even when older detail is pruned.
PACKETCAPTURE_METRICS_UI_RETENTION_DAYS=0
# Upper bound on the number of chart buckets a single history query can
# return, regardless of the requested time range.
PACKETCAPTURE_METRICS_UI_MAX_CHART_BUCKETS=180

# Selected local runtime events: maximum write attempts in a rolling 60 seconds.
# Whole integer 1–600; omitted defaults to 60. Suppressed/failed counts are
# retained with process samples; this operates even with the dashboard off.
PACKETCAPTURE_RUNTIME_EVENT_MAX_PER_MINUTE=60

[
  {
    "name": "echo-bot",
    "channel": "#bot",
    "enabled": true,
    "minHops": 1,
    "maxMessageBytes": 120,
    "commands": [
      { "trigger": "!echo", "response": "🔁 @[{sender}]! {hopCount} hops via {path}" },
      { "trigger": "!spam", "response": "🔁 @[{sender}]! {hopCount} hops via {path}" },
      { "trigger": "!link", "response": "🔗 https://map.okimesh.org/#/packets/{hash}" }
    ]
  }
]
